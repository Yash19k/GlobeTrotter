# GlobeTrotter Backend Environment Variables Example

# Django Security
DJANGO_SECRET_KEY=change-to-a-secure-random-key-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Database Connection (Individual params or DATABASE_URL)
DATABASE_NAME=globetrotter
DATABASE_USER=postgres
DATABASE_PASSWORD=your_local_db_password
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Production Render Database URL (Optional override)
# DATABASE_URL=postgresql://globetrotter_user:password@dpg-sample.oregon-postgres.render.com/globetrotter

# CORS & CSRF
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT Lifetimes
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
